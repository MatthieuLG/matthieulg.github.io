---
import { Image } from 'astro:assets';
import { references } from '../data/references';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="references" class="anchor @container bg-pelouse pb-24 pt-20 lg:pb-32 lg:pt-28">
  <div class="gutter">
    <header>
      <h2 class="display display-section">{t.referencesTitle}</h2>
      <p class="lede mt-5 text-brume">{t.referencesLede}</p>
    </header>

    <ul class="mt-14 grid gap-y-14 lg:mt-16 lg:grid-cols-3 lg:gap-x-12">
      {
        references.map((ref) => (
          <li class="flex flex-col border-t border-craie/20 pt-7">
            <div class="flex items-center gap-4">
              <span class="flex size-14 shrink-0 items-center justify-center rounded-[3px] bg-craie p-2">
                <Image src={ref.logo} alt="" height={80} class="max-h-full w-auto object-contain" loading="lazy" />
              </span>
              <div>
                <h3 class="text-[1.25rem] font-bold leading-[1.2] [font-stretch:104%]">{ref.club}</h3>
                <p class="mt-1 text-[0.875rem] text-brume">{ref.frame[lang]}</p>
              </div>
            </div>

            <p class="mt-6 leading-[1.65] text-craie/85">{ref.context[lang]}</p>

            <ul class="mt-7 space-y-4 lg:mt-auto lg:pt-8">
              {ref.people.map((person) => (
                <li class="grid grid-cols-[0.625rem_minmax(0,1fr)] items-baseline gap-x-3.5">
                  <span class="size-2.5 translate-y-[1px] rounded-full bg-ballon" aria-hidden="true" />
                  <p>
                    <span class="block text-[1.0625rem] font-semibold leading-[1.3]">{person.name}</span>
                    <span class="block text-[0.9375rem] text-brume">{person.role[lang]}</span>
                    {person.note && <span class="block text-[0.875rem] text-brume">{person.note[lang]}</span>}
                  </p>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
